# CalmCare Environment Configuration Template
# Copy this file to .env and configure for your deployment

# Secret key for JWT sessions (Use a strong random 256-bit key in production)
JWT_SECRET=calmcare-development-secret-key-replace-in-production-901239

# Host and Port Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Optional: Google Gemini API Key for enhanced vision OCR & generative explanation
# If omitted, CalmCare uses its built-in deterministic clinical NLP & OCR parser
GEMINI_API_KEY=

# Storage Directory
UPLOAD_DIR=./uploads

# Environment Mode: development / production / testing
ENVIRONMENT=development
